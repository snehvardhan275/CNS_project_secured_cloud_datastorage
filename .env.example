APP_ENV=development
APP_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=secure_storage
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SESSION_TTL_SECONDS=28800
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW_SECONDS=900
OTP_RATE_MAX=5
